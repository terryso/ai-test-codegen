{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-config.schema.json",
  "title": "SiteConfig",
  "description": "Public description of the website under test. Credentials do not belong in this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "baseUrl", "scope", "auth"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includePaths", "maxPages"],
      "properties": {
        "includePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxPages": { "type": "integer", "minimum": 1 }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loginUrl", "usernameSelector", "passwordSelector", "submitSelector"],
      "properties": {
        "loginUrl": { "type": ["string", "null"] },
        "usernameSelector": { "type": ["string", "null"] },
        "passwordSelector": { "type": ["string", "null"] },
        "submitSelector": { "type": ["string", "null"] }
      }
    }
  }
}
