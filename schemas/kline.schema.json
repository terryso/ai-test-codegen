{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kline.schema.json",
  "title": "KlineArtifact",
  "description": "Output of step 4. Index of Kline cases written under tests/kline/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "step", "generatedAt", "dryRun", "sourceArtifact", "target", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "step": { "const": "kline" },
    "generatedAt": { "type": "string" },
    "dryRun": { "type": "boolean" },
    "sourceArtifact": { "type": "string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseUrl"],
      "properties": {
        "name": { "type": "string" },
        "baseUrl": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sourceE2E", "verifiedBy"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "sourceE2E": { "type": "string" },
          "verifiedBy": { "type": "string", "description": "Runner that marked the source E2E test passed, for example dry-run." }
        }
      }
    }
  }
}
