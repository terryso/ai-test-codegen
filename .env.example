# Copy to .env and edit. .env is gitignored. Never commit real credentials.

# Public site under test. Overrides name/baseUrl from the site config file.
TARGET_URL=https://example.com
TARGET_NAME=example

# Optional. Defaults to config/site.json when that file exists, otherwise
# config/site.example.json.
# SITE_CONFIG=config/site.json

# Login page and credentials. Username and password are read at runtime and are
# never written into artifacts, generated tests, or Kline files.
AUTH_LOGIN_URL=
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional selector overrides. Prefer putting selectors in the site config.
AUTH_USERNAME_SELECTOR=
AUTH_PASSWORD_SELECTOR=
AUTH_SUBMIT_SELECTOR=

# Set to 1 to skip the network and the browser and write placeholder artifacts.
# Leave unset for the live stub (one fetch, then a pending E2E run).
# DRY_RUN=1
