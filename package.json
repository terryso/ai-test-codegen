{
  "name": "ai-test-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Humans maintain natural-language e2e tests. Playwright specs are regenerated from the green run's replay cache.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "explore": "tsx scripts/pipeline.ts explore",
    "criteria": "tsx scripts/pipeline.ts criteria",
    "e2e": "tsx scripts/pipeline.ts e2e",
    "run-nl": "tsx scripts/pipeline.ts run-nl",
    "export-pw": "tsx scripts/pipeline.ts export-pw",
    "kline": "tsx scripts/pipeline.ts kline",
    "pipeline": "tsx scripts/pipeline.ts all",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/pipeline/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "e2e": "^0.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
